{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:CONDA_PREFIX}/envs/cxx/include",
                "${env:CONDA_PREFIX}/envs/cxx/include/python3.13",
                "${env:CONDA_PREFIX}/envs/cxx/targets/x86_64-linux/include",
                "${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/include",

                "${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/torch/include",
                "${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/torch/include/torch/csrc/api/include",

                "${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/nvidia/cu13/include",
                "${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/nvidia/cudnn/include",
                "${workspaceFolder}/Libs/cutlass/include"
            ],
            "defines": [
                "__CUDA_ARCH__=1200",
                "CUDNN_FRONTEND_SKIP_JSON_LIB"
            ],
            "compilerPath": "${env:CONDA_PREFIX}/envs/cxx/bin/nvcc",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-ccbin=${env:CONDA_PREFIX}/envs/cxx/bin/g++",
                "--std=c++17"
            ]
        }
    ],
    "version": 4
}
