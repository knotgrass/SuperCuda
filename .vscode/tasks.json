{
    // Start VS Code from a shell with `conda activate cxx`: ${env:CONDA_PREFIX} must be the cxx env.
    "version": "2.0.0",
    "tasks": [
        {
            // Standalone programs only (files with main()). Output: csrc/bin/<name>.out
            "type": "shell",
            "label": "C/C++: nvcc build active file",
            "command": "mkdir -p '${workspaceFolder}/csrc/bin' && '${env:CONDA_PREFIX}/bin/nvcc' -g -G -std=c++20 -arch=sm_120 -I'${workspaceFolder}/common' -I'${workspaceFolder}/third_party/cutlass/include' '${file}' -o '${workspaceFolder}/csrc/bin/${fileBasenameNoExtension}.out'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$nvcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "nvcc -g -G (debug host & device), sm_120"
        },
        {
            "type": "shell",
            "label": "ext: build release",
            "command": "${workspaceFolder}/script/build.sh release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$nvcc",
                "$gcc"
            ],
            "group": "build",
            "detail": "JIT-build the Torch extension into build/release (-O3 -lineinfo)"
        },
        {
            "type": "shell",
            "label": "ext: build debug",
            "command": "${workspaceFolder}/script/build.sh debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$nvcc",
                "$gcc"
            ],
            "group": "build",
            "detail": "JIT-build the Torch extension into build/debug (-O0 -g -G)"
        },
        {
            "type": "shell",
            "label": "ext: compdb",
            "command": "${workspaceFolder}/script/compdb.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ext: build release",
            "problemMatcher": [],
            "detail": "Write compile_commands.json for IntelliSense"
        },
        {
            "type": "shell",
            "label": "pytest",
            "command": "python -m pytest tests -q",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "detail": "Run all tests (release build)"
        }
    ]
}
