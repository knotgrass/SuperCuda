{
    // The cxx conda env is CONDA_ENV_PREFIX in settings.json (terminal.integrated.env.linux), read here with
    // ${config:...}. Do not use ${env:CONDA_PREFIX}: inside VS Code it is the base env.
    // All tasks are "process" tasks: the Nsight extension registers its own task type named "shell", so a
    // "type": "shell" task matches two schemas and VS Code warns on it.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        // Same environment as `conda activate cxx` (README: conda env config vars). 8.6 on the A10.
        "env": {
            "CONDA_PREFIX": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}",
            "CUDA_HOME": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}",
            "TORCH_CUDA_ARCH_LIST": "12.0",
            "PATH": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin:${env:PATH}"
        }
    },
    "tasks": [
        {
            // Program directory: main.cu + kernel files, like csrc/sgemm/. Compiles every *.cu and *.cpp in the
            // directory of the active file, so keep one main() per directory. Output: csrc/bin/<dirname>.out
            "type": "process",
            "label": "C/C++: nvcc build active dir",
            "command": "bash",
            // bash creates the output dir, then runs "$@" (the nvcc command below, one arg per line) with the
            // sources appended. nullglob drops a pattern with no match (a directory without .cpp files).
            "args": [
                "-c",
                "shopt -s nullglob && mkdir -p '${workspaceFolder}/csrc/bin' && exec \"$@\" '${fileDirname}'/*.cu '${fileDirname}'/*.cpp",
                "bash", // $0
                "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/nvcc",
                "-g",
                "-G",
                "-std=c++20",
                "-arch=sm_120",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/libs/cutlass/include",
                "-o",
                "${workspaceFolder}/csrc/bin/${fileDirnameBasename}.out"
            ],
            "problemMatcher": [
                "$nvcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "nvcc -g -G (debug host & device), sm_120: main.cu + kernels in the active file's directory"
        },
        {
            // One file with main() (old lessons: csrc/helloworld.cu, csrc/L1_*/...). Output: csrc/bin/<name>.out
            "type": "process",
            "label": "C/C++: nvcc build active file",
            "command": "bash",
            // bash creates the output dir, then runs "$@" (the nvcc command below, one arg per line).
            "args": [
                "-c",
                "mkdir -p '${workspaceFolder}/csrc/bin' && exec \"$@\"",
                "bash", // $0
                "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/nvcc",
                "-g",
                "-G",
                "-std=c++20",
                "-arch=sm_120",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/libs/cutlass/include",
                "${file}",
                "-o",
                "${workspaceFolder}/csrc/bin/${fileBasenameNoExtension}.out"
            ],
            "problemMatcher": [
                "$nvcc"
            ],
            "group": "build",
            "detail": "nvcc -g -G (debug host & device), sm_120: one file"
        },
        {
            "type": "process",
            "label": "ext: build release",
            "command": "${workspaceFolder}/script/build.sh",
            "args": [
                "release"
            ],
            "problemMatcher": [
                "$nvcc",
                "$gcc"
            ],
            "group": "build",
            "detail": "JIT-build the Torch extension into build/release (-O3 -lineinfo)"
        },
        {
            "type": "process",
            "label": "ext: build debug",
            "command": "${workspaceFolder}/script/build.sh",
            "args": [
                "debug"
            ],
            "problemMatcher": [
                "$nvcc",
                "$gcc"
            ],
            "group": "build",
            "detail": "JIT-build the Torch extension into build/debug (-O0 -g -G)"
        },
        {
            "type": "process",
            "label": "ext: compdb",
            "command": "${workspaceFolder}/script/compdb.sh",
            "dependsOn": "ext: build release",
            "problemMatcher": [],
            "detail": "Write compile_commands.json for IntelliSense"
        },
        {
            "type": "process",
            "label": "pytest",
            "command": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q"
            ],
            "problemMatcher": [],
            "group": "test",
            "detail": "Run all tests (release build)"
        }
    ]
}
