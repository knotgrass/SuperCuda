{
    // Start VS Code from a shell with `conda activate cxx`: ${env:CONDA_PREFIX} must be the cxx env.
    "version": "0.2.0",
    "configurations": [
        {
            // Standalone program (open a csrc/*.cu file with main()).
            "name": "C/C++: nvcc build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/csrc/bin/${fileBasenameNoExtension}.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${env:CONDA_PREFIX}/lib"
                },
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:CONDA_PREFIX}/bin/cuda-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA focus to device kernel",
                    "text": "set cuda break_on_launch application",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: nvcc build active file"
        },
        {
            // Kernel debugging through pytest: set a breakpoint in a *_cuda/*.cu file, open a tests/test_*.py file.
            // Uses the debug build (-G) in build/debug.
            "name": "cuda-gdb: pytest current file",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${env:CONDA_PREFIX}/bin/python",
            "args": "-m pytest ${file} -x -s",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "SUPERCUDA_BUILD",
                    "value": "debug"
                }
            ],
            "debuggerPath": "${env:CONDA_PREFIX}/bin/cuda-gdb",
            "preLaunchTask": "ext: build debug"
        },
        {
            // Python-side debugging of a test file (release build).
            "name": "Python: pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-x",
                "-s"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
