{
    // The cxx conda env is CONDA_ENV_PREFIX in settings.json (terminal.integrated.env.linux), read here with
    // ${config:...}. Do not use ${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}: inside VS Code it is the base env.
    "version": "0.2.0",
    "configurations": [
        {
            // Program directory (open any file of csrc/<lesson>/: main.cu + kernel files). Builds and debugs
            // csrc/bin/<dirname>.out. Type cuda-gdb (Nsight): the cppdbg type does not understand CUDA stop
            // events and shows "Unknown stopping event" at every kernel launch.
            "name": "C/C++: nvcc build and debug active dir",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/csrc/bin/${fileDirnameBasename}.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/lib"
                },
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                }
            ],
            "debuggerPath": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/cuda-gdb",
            // Stop at the first instruction of every kernel (was `set cuda break_on_launch application`).
            "breakOnLaunch": false,
            "preLaunchTask": "C/C++: nvcc build active dir"
        },
        {
            // One file with main() (old lessons: csrc/helloworld.cu, csrc/L1_*/...). Same cuda-gdb setup.
            "name": "C/C++: nvcc build and debug active file",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/csrc/bin/${fileBasenameNoExtension}.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/lib"
                },
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                }
            ],
            "debuggerPath": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/cuda-gdb",
            // Stop at the first instruction of every kernel (was `set cuda break_on_launch application`).
            "breakOnLaunch": false,
            "preLaunchTask": "C/C++: nvcc build active file"
        },
        {
            // Kernel debugging through pytest: set a breakpoint in a *_cuda/*.cu file, open a tests/test_*.py file.
            // Uses the debug build (-G) in build/debug.
            "name": "cuda-gdb: pytest current file",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/python",
            "args": "-m pytest ${file} -x -s",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "SUPERCUDA_BUILD",
                    "value": "debug"
                }
            ],
            "debuggerPath": "${config:terminal.integrated.env.linux.CONDA_ENV_PREFIX}/bin/cuda-gdb",
            "preLaunchTask": "ext: build debug"
        },
        {
            // Python-side debugging of a test file (release build).
            "name": "Python: pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-x",
                "-s"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
