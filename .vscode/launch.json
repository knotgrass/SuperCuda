{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: nvcc build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/../bin/${fileBasenameNoExtension}.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${env:CONDA_PREFIX}/envs/cxx/lib:${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/torch/lib:${env:CONDA_PREFIX}/envs/cxx/lib/python3.13/site-packages/nvidia/cudnn/lib:${workspaceFolder}/Libs/cutlass/lib"
                },
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:CONDA_PREFIX}/envs/cxx/bin/cuda-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA focus to device kernel",
                    "text": "set cuda break_on_launch application",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: nvcc build active file"
        }
    ]
}
